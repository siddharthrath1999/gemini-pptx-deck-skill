---
import { WORKS } from "../data/content";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<section class="works" aria-label="Where it works">
  <div class="wrap row rv">
    {WORKS.map((w) => (
      <div class="work">
        <span class={`app ${w.tint}`}><img src={`${base}${w.logo}`} alt={w.alt} width="34" height="34" loading="lazy" /></span>
        <div><b>{w.title}</b><small>{w.text}</small></div>
      </div>
    ))}
  </div>
</section>

<style>
  .works { padding: 0 0 var(--sec); }
  .row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .work { padding: 22px; border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--bg-2); display: flex; gap: 18px; align-items: center; transition: border-color .2s; }
  .work:hover { border-color: var(--line-2); }
  b { display: block; font-weight: 500; font-size: 16px; letter-spacing: -0.015em; }
  small { display: block; color: var(--muted); font-size: 14px; line-height: 1.45; margin-top: 3px; }
  @media (max-width: 980px) { .row { grid-template-columns: 1fr; } }
</style>
