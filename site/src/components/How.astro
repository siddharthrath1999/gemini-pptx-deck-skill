---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { img } from "../lib/images";
import { RUN } from "../data/content";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const labels = ["your request", ...RUN.steps.map((s) => s.label)];
---
<section id="how">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">How it works</span>
      <h2>One request, start to finish.</h2>
      <p class="lead">A real run in Gemini's Task mode: the steps it took, the slides it made, and its answer. It plays once when you get here; tap any step to see it.</p>
    </div>
    <div class="replay rv" id="replay" data-labels={JSON.stringify(labels)}>
      <div class="thread">
        <div class="top"><img src={`${base}logos/gemini-2025.svg`} alt="" width="18" height="18" loading="lazy" />Gemini · Task<span class="chip on">@pptx-native</span></div>
        <ol class="body" id="thread">
          <li class="msg user shown is-step" data-step="0"><button type="button"><b>@pptx-native</b> {RUN.request}</button></li>
          {RUN.steps.map((s, i) => (
            <li class="msg is-step" data-step={i + 1}>
              <button type="button">
                <span class="ic">
                  <span class="s-wait"><Icon name={s.icon} /></span>
                  <span class="s-run"><Icon name="progress_activity" /></span>
                  <span class="s-done"><Icon name="check_circle" /></span>
                </span>
                <span><b>{s.title}</b><small>{s.sub}</small></span>
              </button>
            </li>
          ))}
        </ol>
        <div class="composer" aria-hidden="true"><Icon name="add" /><span class="ph">Ask a follow-up</span><span class="chip">Argon</span><Icon name="mic" /></div>
      </div>

      <div class="board" id="board" aria-live="polite">
        <div class="label">Being made · <b id="boardLabel">{labels[0]}</b>
          <button type="button" class="again" id="replayAgain" hidden><Icon name="restart_alt" />Play again</button>
        </div>
        <div class="scene active">
          <div class="prompt-card"><b>@pptx-native</b> {RUN.request}<div class="att"><span class="chip on"><Icon name="extension" />pptx-native</span><span class="chip"><Icon name="bolt" />Task</span><span class="chip">Argon</span></div></div>
        </div>
        <div class="scene">
          {RUN.research.map(([icon, text, tag]) => <div class="row"><span class="well sm"><Icon name={icon} /></span>{text}<span class={`r ${tag === "set aside" ? "" : "ok"}`}>{tag}</span></div>)}
        </div>
        <div class="scene">
          <ol class="outline">{RUN.outline.map((t, i) => <li><span>0{i + 1}</span>{t}</li>)}</ol>
        </div>
        <div class="scene">
          <div class="palette">{RUN.palette.map((c) => <i style={`background:${c}`}></i>)}</div>
          <div class="type-spec"><b>Aa</b><span>{RUN.font}</span></div>
        </div>
        <div class="scene">
          <div class="thumbs">{RUN.thumbs.map((p) => <Image src={img(p)} alt="" widths={[320, 640]} sizes="(max-width: 640px) 30vw, 180px" />)}</div>
        </div>
        <div class="scene">
          {RUN.checks.map(([icon, text, tag]) => <div class="row"><span class="well sm ok"><Icon name={icon} /></span>{text}<span class="r ok">{tag}</span></div>)}
        </div>
        <div class="scene">
          <figure class="real">
            <Image src={img("run/gemini-answer.jpg")} alt="Gemini's real answer: the 15-slide deck file and the handoff note" />
            <figcaption><Icon name="photo_camera" />Real screenshot · Gemini Task mode, October 2026</figcaption>
          </figure>
        </div>
        <div class="progress"><i id="replayBar"></i></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { $, $$, onFirstView, reduceMotion } from "../scripts/util";
  const root = $("#replay")!;
  const labels: string[] = JSON.parse(root.dataset.labels || "[]");
  const msgs = $$(".is-step", root), scenes = $$(".scene", root), thread = $("#thread", root)!;
  const label = $("#boardLabel", root)!, bar = $("#replayBar", root)!, again = $("#replayAgain", root)!;
  const last = scenes.length - 1;
  let now = -1, timer = 0, hovering = false, playing = false;

  function show(i: number) {
    now = i;
    msgs.forEach((m, k) => {
      m.classList.toggle("shown", k <= i);
      m.classList.toggle("current", k === i && k > 0 && i < last);
      m.classList.toggle("done", k > 0 && (k < i || i === last));
      m.querySelector("button")!.setAttribute("aria-current", k === i ? "step" : "false");
    });
    scenes.forEach((s, k) => s.classList.toggle("active", k === i));
    label.textContent = labels[i];
    bar.style.width = `${((i + 1) / scenes.length) * 100}%`;
    const m = msgs[i];
    const top = m.offsetTop - thread.offsetTop + m.offsetHeight - thread.clientHeight + 16;
    thread.scrollTo({ top: Math.max(0, top), behavior: reduceMotion() ? "auto" : "smooth" });
    again.hidden = !(i === last && !playing);
  }
  function stop() { clearTimeout(timer); playing = false; again.hidden = now !== last; }
  function tick() {
    if (!playing) return;
    if (hovering) { timer = window.setTimeout(tick, 400); return; }
    if (now >= last) { stop(); return; }
    show(now + 1);
    timer = window.setTimeout(tick, 2300);
  }
  function play(from = 0) { stop(); playing = true; show(from); timer = window.setTimeout(tick, 2300); }

  msgs.forEach((m, i) => m.querySelector("button")!.addEventListener("click", () => { stop(); show(i); }));
  again.addEventListener("click", () => play(0));
  root.addEventListener("pointerenter", () => { hovering = true; });
  root.addEventListener("pointerleave", () => { hovering = false; });
  show(0);
  if (reduceMotion()) show(last);
  else onFirstView(root, () => play(0), 0.4);
</script>

<style>
  .replay { display: grid; grid-template-columns: 1fr 1.08fr; gap: 20px; height: clamp(540px, 72vh, 660px); }
  .thread { border-radius: var(--r-lg); border: 1px solid var(--line-2); background: #131314; display: flex; flex-direction: column; overflow: hidden; min-height: 0; }
  .top { display: flex; align-items: center; gap: 10px; height: 52px; padding: 0 16px; border-bottom: 1px solid var(--line); font-size: 13.5px; font-weight: 500; color: var(--soft); flex: none; }
  .top img { width: 18px; height: 18px; }
  .top .chip { margin-left: auto; height: 26px; font-size: 12px; }
  .body { list-style: none; margin: 0; padding: 18px; display: flex; flex-direction: column; gap: 10px; overflow: hidden; flex: 1; min-height: 0; }
  .msg { opacity: 0; transform: translateY(8px); transition: opacity .4s var(--ease), transform .45s var(--ease); }
  .msg.shown { opacity: 1; transform: none; }
  .msg button { all: unset; box-sizing: border-box; cursor: pointer; display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; width: 100%; padding: 6px 8px; border-radius: 10px; font-size: 14px; line-height: 1.5; color: #c4c7c5; transition: background-color .2s; }
  .msg button:hover { background: rgba(255,255,255,.03); }
  .msg button:focus-visible { outline: 2px solid var(--accent-2); outline-offset: 2px; }
  .msg button[aria-current="step"] { background: rgba(255,255,255,.04); }
  .user { align-self: flex-end; max-width: 84%; }
  .user button { display: block; background: #1e1f20; border-radius: 22px 22px 6px 22px; padding: 12px 16px; color: #e3e3e3; }
  .user button:hover, .user button[aria-current="step"] { background: #232426; }
  .msg b { color: #e3e3e3; font-weight: 500; }
  .user b { font-weight: 600; color: #fff; }
  .msg small { display: block; font: 400 12px/1.4 var(--mono); color: #80868b; margin-top: 3px; }
  .ic { width: 22px; height: 22px; display: grid; place-items: center; }
  .ic :global(.i) { width: 18px; height: 18px; }
  .s-wait { color: #a8abb0; } .s-run { color: var(--accent-2); display: none; } .s-done { color: var(--ok); display: none; }
  .s-wait, .s-run, .s-done { line-height: 0; }
  .current .s-wait, .done .s-wait { display: none; }
  .current .s-run { display: block; animation: spin 1.1s linear infinite; }
  .done .s-done { display: block; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .composer { flex: none; margin: 0 14px 14px; height: 46px; border-radius: 23px; background: #1e1f20; display: flex; align-items: center; gap: 10px; padding: 0 12px 0 14px; color: #8e918f; font-size: 13.5px; }
  .composer .ph { flex: 1; }
  .composer :global(.i) { color: #a8abb0; }
  .composer .chip { height: 26px; border-color: transparent; background: none; color: #c4c7c5; }

  .board { position: relative; border-radius: var(--r-lg); border: 1px solid var(--line); background: radial-gradient(90% 70% at 70% 0%, rgba(59,79,216,.14), transparent 60%), var(--bg-2); overflow: hidden; min-height: 0; }
  .label { position: absolute; inset: 0 0 auto; height: 52px; padding: 0 12px 0 20px; z-index: 2; font: 400 11.5px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); display: flex; gap: 8px; align-items: center; border-bottom: 1px solid var(--line); background: rgba(17,17,19,.7); }
  .label b { color: var(--ink); font-weight: 400; }
  .again { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--line-2); background: rgba(255,255,255,.04); color: var(--soft); font: 500 12px/1 var(--sans); letter-spacing: 0; text-transform: none; cursor: pointer; }
  .again:hover { color: var(--ink); border-color: var(--line-3); }
  .again :global(.i) { width: 16px; height: 16px; }
  .scene { position: absolute; inset: 52px 0 2px; padding: 24px; display: grid; grid-template-columns: minmax(0, 1fr); align-content: center; gap: 10px; opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity .4s var(--ease), transform .5s var(--ease), visibility 0s .4s; }
  .scene.active { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .row { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 9px 14px 9px 10px; border-radius: 12px; background: rgba(255,255,255,.03); border: 1px solid var(--line); font-size: 14px; }
  .well.ok { color: var(--ok); }
  .r { margin-left: auto; font: 400 11.5px var(--mono); color: var(--muted); white-space: nowrap; }
  .r.ok { color: var(--ok); }
  .prompt-card { border-radius: 16px; border: 1px solid var(--line-2); background: var(--bg-3); padding: 18px; font-size: 16px; line-height: 1.5; }
  .prompt-card b { font-weight: 600; }
  .att { display: flex; gap: 6px; margin-top: 14px; flex-wrap: wrap; }
  .outline { list-style: none; margin: 0; padding: 0; }
  .outline li { display: grid; grid-template-columns: 34px 1fr; gap: 8px; padding: 11px 2px; border-bottom: 1px solid var(--line); font-size: 15px; }
  .outline span { font: 400 12px/1.8 var(--mono); color: var(--accent-2); }
  .palette { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .palette i { aspect-ratio: 1 / 1.3; border-radius: 12px; display: block; border: 1px solid var(--line); }
  .type-spec { display: flex; gap: 18px; align-items: end; margin-top: 6px; }
  .type-spec b { font: 400 60px/1 Georgia, serif; }
  .type-spec span { color: var(--muted); font-size: 14px; }
  .thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .thumbs :global(img) { width: 100%; border-radius: 6px; aspect-ratio: 16 / 9; object-fit: cover; }
  .real { margin: 0; display: grid; gap: 10px; }
  .real :global(img) { width: 100%; border-radius: 12px; border: 1px solid var(--line-2); }
  .real figcaption { display: inline-flex; align-items: center; gap: 6px; font: 500 11.5px/1 var(--mono); color: var(--muted); }
  .real figcaption :global(.i) { width: 16px; height: 16px; }
  .progress { position: absolute; inset: auto 0 0; height: 2px; background: var(--line); z-index: 3; }
  .progress i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .4s var(--ease); }
  @media (max-width: 980px) {
    .replay { grid-template-columns: 1fr; height: auto; }
    .board { order: -1; aspect-ratio: 4 / 3.4; }
    .body { flex: none; height: 300px; }
  }
  @media (max-width: 640px) {
    .board { aspect-ratio: 3 / 3.7; }
    .scene { padding: 16px; }
    .body { height: 260px; }
    .row { font-size: 13px; }
  }
</style>
