---
// How it works: five linked steps from a real run, then the slides it produced.
// Desktop reads left to right; below 900px the same list becomes a vertical timeline.
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { img } from "../lib/images";
import { HOW, EXAMPLES } from "../data/content";
const run = EXAMPLES[0];
---
<section id="how">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">How it works</span>
      <h2>One sentence in.<br />A finished deck out.</h2>
      <p class="lead">A real run in Gemini's Task mode, step by step. You write the first line; the skill does the rest.</p>
    </div>

    <ol class="path" id="path">
      {HOW.steps.map((s, i) => (
        <li style={`--i:${i}`}>
          <span class="dot"><Icon name={s.icon} /></span>
          <div class="body">
            <h3><span class="n">{i + 1}</span>{s.title}</h3>
            <p>{s.text}</p>
            <div class="art" aria-hidden="true">
              {i === 0 && <span class="ask"><b>@pptx-native</b> {HOW.request}</span>}
              {i === 1 && <span class="srcs">{HOW.sources.map((x) => <span class="tag">{x}</span>)}<span class="tag more">+8 more</span></span>}
              {i === 2 && <span class="look"><span class="sw">{HOW.palette.map((c) => <i style={`background:${c}`}></i>)}</span><span>Five-part story · Georgia and Arial</span></span>}
              {i === 3 && <span class="ok">{HOW.checks.map((c) => <span><Icon name="check_circle" fill />{c}</span>)}</span>}
              {i === 4 && <span class="file"><Icon name="present_to_all" /><span><b>The finished .pptx</b>15 slides · 12 sources</span></span>}
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="out rv">
      <div class="out-head">
        <h3>What came out</h3>
        <button type="button" class="textlink" data-deck="0" data-slide="0" aria-haspopup="dialog">Page through the slides<Icon name="arrow_forward" /></button>
      </div>
      <ul class="strip">
        {run.slides.map((p, k) => (
          <li><button type="button" data-deck="0" data-slide={k} aria-haspopup="dialog" aria-label={`Open slide ${k + 1} of the ${run.title} deck`}>
            <Image src={img(p)} alt="" widths={[320, 560]} sizes="(max-width: 900px) 62vw, 150px" />
          </button></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { $, onFirstView, reduceMotion } from "../scripts/util";
  const path = $("#path")!;
  if (reduceMotion()) path.classList.add("go");
  else onFirstView(path, () => path.classList.add("go"), 0.3);
</script>

<style>
  .path { --dot: 44px; position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  /* the connecting line: a quiet track, and an accent fill that runs once */
  .path::before, .path::after { content: ""; position: absolute; top: calc(var(--dot) / 2 - 1px); left: 10%; right: 10%; height: 2px; border-radius: 2px; }
  .path::before { background: var(--line-2); }
  .path::after { background: linear-gradient(90deg, var(--accent), var(--accent-2)); transform-origin: left; }
  :global(.js) .path::after { transform: scaleX(0); transition: transform 1.8s var(--ease) .2s; }
  :global(.js) .path:global(.go)::after { transform: none; }

  li { position: relative; display: grid; grid-template-rows: var(--dot) 1fr; gap: 16px; justify-items: center; }
  .dot { position: relative; z-index: 1; width: var(--dot); height: var(--dot); border-radius: 50%; display: grid; place-items: center; background: #1d1310; border: 1px solid var(--accent-line); color: var(--accent-2); }
  .dot :global(.i) { width: 21px; height: 21px; }
  .body { width: 100%; display: flex; flex-direction: column; gap: 6px; padding: 16px; border-radius: var(--r-md); border: 1px solid var(--line); background: var(--bg-2); }
  h3 { display: flex; align-items: center; gap: 8px; font-size: 16px; }
  .n { font: 500 11px/1 var(--mono); color: var(--faint); }
  .body > p { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--muted); }
  .art { margin-top: auto; padding-top: 10px; font-size: 12.5px; line-height: 1.5; color: var(--soft); }
  .art > span { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px; min-height: 68px; border-radius: 10px; background: var(--bg-3); border: 1px solid var(--line); align-content: flex-start; }
  .ask { display: block !important; }
  .ask b { color: var(--accent-2); font-weight: 500; }
  .tag { height: 22px; display: inline-flex; align-items: center; padding: 0 7px; border-radius: 6px; border: 1px solid var(--line-2); font: 500 11px/1 var(--mono); color: var(--soft); }
  .tag.more { color: var(--muted); border-style: dashed; }
  .look { flex-direction: column; }
  .sw { display: flex; gap: 4px; }
  .sw i { width: 18px; height: 18px; border-radius: 5px; box-shadow: inset 0 0 0 1px rgba(255,255,255,.12); }
  .ok { flex-direction: column; gap: 4px !important; }
  .ok > span { display: flex; align-items: center; gap: 6px; }
  .ok :global(.i) { width: 16px; height: 16px; color: var(--ok); }
  .file { align-items: center; flex-wrap: nowrap !important; gap: 10px !important; }
  .file :global(.i) { width: 26px; height: 26px; color: var(--accent-2); }
  .file span { display: grid; color: var(--muted); font-size: 12px; min-width: 0; }
  .file b { color: var(--ink); font-weight: 500; font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* each step lights up as the line reaches it */
  :global(.js) .dot, :global(.js) .body { transition: border-color .4s, color .4s, background-color .4s, opacity .5s var(--ease), transform .5s var(--ease); transition-delay: calc(var(--i) * 320ms + 150ms); }
  :global(.js) .body { opacity: .35; transform: translateY(8px); }
  :global(.js) .path:global(.go) .body { opacity: 1; transform: none; }
  :global(.js) .path:not(:global(.go)) .dot { color: var(--muted); border-color: var(--line-2); background: var(--bg-3); }

  .out { margin-top: 36px; }
  .out-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  .out-head h3 { font-size: 17px; }
  .out-head button { background: none; border: 0; padding: 0; cursor: pointer; }
  .strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 10px; }
  .strip button { display: block; width: 100%; padding: 0; border: 1px solid var(--line-2); border-radius: 8px; overflow: hidden; background: none; cursor: zoom-in; transition: border-color .2s, transform .25s var(--ease); }
  .strip button:hover { border-color: var(--line-3); transform: translateY(-2px); }
  .strip :global(img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }

  @media (max-width: 900px) {
    /* vertical timeline: line on the left, every step fully visible */
    .path { --dot: 40px; grid-template-columns: 1fr; gap: 12px; }
    .path::before, .path::after { top: 20px; bottom: 20px; left: calc(var(--dot) / 2 - 1px); right: auto; width: 2px; height: auto; }
    .path::after { background: linear-gradient(var(--accent), var(--accent-2)); transform-origin: top; }
    :global(.js) .path::after { transform: scaleY(0); }
    li { grid-template-rows: none; grid-template-columns: var(--dot) minmax(0, 1fr); justify-items: stretch; align-items: start; gap: 14px; }
    .body { padding: 14px; }
    .art > span { min-height: 0; }
    .strip { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin: 0 -16px; padding: 0 16px 4px; }
    .strip::-webkit-scrollbar { display: none; }
    .strip li { flex: 0 0 31%; scroll-snap-align: start; }
  }
  @media (max-width: 640px) {
    .strip li { flex-basis: 62%; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .body { padding: 14px 12px; }
    .file b { white-space: normal; overflow-wrap: anywhere; }
  }
</style>
