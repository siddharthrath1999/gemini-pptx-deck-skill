---
// Set up: two plain cards, one per place you can use the skill. Side by side on desktop, stacked on phones.
import Icon from "./Icon.astro";
import { ZIP_URL, INSTALL, PROMPT_CATS } from "../data/content";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<section id="setup">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">Set up in two minutes</span>
      <h2>Pick where you work.</h2>
      <p class="lead">The skill is free and open source. Use it in the Gemini app, or add it to Antigravity with one line.</p>
    </div>

    <div class="two">
      <article class="card rv" id="setup-gemini">
        <header>
          <span class="app gemini"><img src={`${base}logos/gemini-2025.svg`} alt="" width="30" height="30" loading="lazy" /></span>
          <div><h3>Gemini app</h3><p>On the web and the Mac app. Needs Google AI Pro or Ultra for Task mode.</p></div>
        </header>
        <ol class="steps">
          <li><span class="n">1</span><div><b>Download the skill</b><span>Keep the file zipped.</span>
            <a class="btn primary sm dl" href={ZIP_URL}><Icon name="download" />Download pptx-native.zip</a></div></li>
          <li><span class="n">2</span><div><b>Open Customise, then Skills</b><span>In Gemini's left menu.</span></div></li>
          <li><span class="n">3</span><div><b>Click Create, then Upload</b><span>Choose the zip and confirm.</span></div></li>
          <li><span class="n">4</span><div><b>Pick Task and ask</b><span>In a new chat, pick Task under the box, type <code>@pptx-native</code> and describe your deck.</span></div></li>
        </ol>
        <p class="note"><Icon name="info" />Upload says it didn't pass the security scan? Upload the official zip, unchanged.</p>
      </article>

      <article class="card rv" id="setup-antigravity">
        <header>
          <span class="app agy"><img src={`${base}logos/antigravity.png`} alt="" width="30" height="30" loading="lazy" /></span>
          <div><h3>Google Antigravity</h3><p>Runs on your own computer. Also works with other agents that run Python.</p></div>
        </header>
        <ol class="steps">
          <li><span class="n">1</span><div><b>Copy one line</b>
            <div class="term" data-cmds={JSON.stringify(INSTALL)}>
              <div class="os" role="tablist" aria-label="Your system" id="osTabs">
                <button type="button" role="tab" aria-selected="true" data-os="mac">macOS · Linux</button>
                <button type="button" role="tab" aria-selected="false" data-os="win">Windows</button>
                <button type="button" role="tab" aria-selected="false" data-os="npx">npx</button>
              </div>
              <div class="cmd"><code id="termCmd">{INSTALL.mac}</code>
                <button type="button" class="btn sm" id="copyCmd"><span class="when-idle"><Icon name="content_copy" /></span><span class="when-copied"><Icon name="check" /></span><span class="when-idle">Copy</span><span class="when-copied">Copied</span></button>
              </div>
            </div></div></li>
          <li><span class="n">2</span><div><b>Paste it into Terminal</b><span>It installs the skill and the two Python packages it needs.</span></div></li>
          <li><span class="n">3</span><div><b>Restart Antigravity and ask</b><span>“Make me a 30-slide deck on our Q3 results.” The deck is saved in your project.</span></div></li>
        </ol>
        <p class="note"><Icon name="info" />To install into one project only, add <code>--project</code> to the end of the command.</p>
      </article>
    </div>

    <a class="next rv" href={`${base}prompts.html`}>
      <div>
        <h3>Not sure what to ask?</h3>
        <p>Start from one of 24 prompts that already make good decks, or build your own in a few taps.</p>
        <span class="peek">{PROMPT_CATS.slice(1).map((c) => <span class="chip"><Icon name={c.icon} />{c.label}</span>)}</span>
      </div>
      <span class="btn lg">Prompts and layouts<Icon name="arrow_forward" /></span>
    </a>
  </div>
</section>

<script>
  import { $, $$, copyText } from "../scripts/util";
  const term = $(".term")!;
  const cmds: Record<string, string> = JSON.parse(term.dataset.cmds || "{}");
  const code = $("#termCmd")!;
  let os = "mac";
  $$<HTMLButtonElement>("#osTabs button").forEach((b, _, all) => b.addEventListener("click", () => {
    all.forEach((x) => x.setAttribute("aria-selected", String(x === b)));
    os = b.dataset.os!; code.textContent = cmds[os];
  }));
  $("#copyCmd")!.addEventListener("click", (e) => copyText(cmds[os], e.currentTarget as HTMLElement));
</script>

<style>
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-items: stretch; }
  .card { display: flex; flex-direction: column; gap: 20px; padding: 24px; border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--bg-2); scroll-margin-top: calc(var(--nav-h) + 32px); }
  .card:target { border-color: var(--accent-line); }
  header { display: flex; gap: 16px; align-items: center; }
  header .app { --s: 52px; }
  header p { margin: 4px 0 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .steps li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; align-items: start; }
  .n { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; font: 500 12.5px/1 var(--mono); color: var(--accent-2); background: var(--accent-soft); border: 1px solid var(--accent-line); }
  .steps b { display: block; font-size: 15px; font-weight: 500; line-height: 28px; }
  .steps li > div > span { display: block; color: var(--muted); font-size: 14px; line-height: 1.5; }
  code { font: 500 12.5px var(--mono); color: var(--soft); background: var(--bg-3); border: 1px solid var(--line); border-radius: 5px; padding: 1px 5px; }
  .dl { margin-top: 10px; }
  .note { margin: auto 0 0; display: flex; gap: 8px; align-items: flex-start; font-size: 13px; line-height: 1.5; color: var(--faint); }
  .note :global(.i) { width: 17px; height: 17px; margin-top: 1px; }

  .term { margin-top: 10px; border-radius: 12px; border: 1px solid var(--line-2); background: #09090a; overflow: hidden; }
  .os { display: flex; gap: 2px; padding: 6px; border-bottom: 1px solid var(--line); }
  .os button { height: 28px; padding: 0 10px; border-radius: 7px; border: 1px solid transparent; background: none; color: var(--muted); font: 500 12px var(--mono); cursor: pointer; }
  .os button[aria-selected="true"] { background: rgba(255,255,255,.07); color: #fff; border-color: var(--line); }
  .cmd { display: flex; align-items: center; gap: 10px; padding: 10px 10px 10px 14px; }
  .cmd code { flex: 1; min-width: 0; background: none; border: 0; padding: 0; color: #e8e4dc; font-size: 12.5px; line-height: 1.6; overflow-wrap: anywhere; }

  .next { margin-top: 14px; border-radius: var(--r-lg); border: 1px solid var(--line-2); background: radial-gradient(70% 140% at 100% 0%, rgba(59,79,216,.2), transparent 60%), var(--bg-2); padding: 24px; display: grid; grid-template-columns: 1fr auto; gap: 18px 32px; align-items: center; transition: border-color .2s; }
  .next:hover { border-color: var(--line-3); }
  .next h3 { font-size: 20px; }
  .next p { margin: 6px 0 0; color: var(--muted); font-size: 15px; }
  .peek { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 14px; }

  @media (max-width: 900px) {
    .two, .next { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .card { padding: 18px; }
    /* the command gets the full width; Copy sits under it */
    .cmd { flex-direction: column; align-items: stretch; gap: 8px; padding: 12px; }
    .cmd code { overflow-wrap: anywhere; }
    .cmd .btn { align-self: flex-end; }
    .peek { display: none; }
    .next .btn { width: 100%; }
  }
</style>
