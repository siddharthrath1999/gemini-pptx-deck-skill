---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { img } from "../lib/images";
import { LAYOUTS } from "../data/content";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const bars = [0.3, 0.45, 0.4, 0.6, 0.52, 0.75, 1, 0.68];
const notes = "Riders doubled in three quarters. Pause here, then point to Pune: it turned profitable first. Next, we look at why.";
const narrow = "(max-width: 640px) 90vw, (max-width: 980px) 45vw, 280px";
---
<section id="features">
  <div class="wrap">
    <div class="sec-head rv"><span class="eyebrow">Features</span><h2>Built to be presented, not just generated.</h2></div>
    <div class="bento" id="bento">
      <article class="tile w2 rv"><div class="demo" aria-hidden="true"><div class="chart"><div class="cap"><span>Riders, thousands</span><b>Edit data in PowerPoint</b></div><div class="bars">{bars.map((h, i) => <i class={i === 6 ? "hl" : ""} style={`--h:${h};--i:${i}`}></i>)}</div></div></div><h3>Native charts, data inside</h3><p>Column, bar, line, pie, scatter, waterfall and more. Click a chart in PowerPoint and edit its numbers.</p></article>

      <article class="tile rv"><div class="demo" aria-hidden="true"><div class="cycle fit" data-cycle>
        {["l06", "l15", "l20", "l22"].map((n, i) => <Image class={i === 0 ? "on" : ""} src={img(`layouts/${n}.jpg`)} alt="" widths={[400, 760]} sizes={narrow} />)}
      </div></div><h3>{LAYOUTS.length} layouts</h3><p>Picked from the shape of your content, including ones for your own photos. <a class="more" href={`${base}prompts.html#layouts`}>See them all</a></p></article>

      <article class="tile rv"><div class="demo" aria-hidden="true"><ul class="ticks">
        <li style="--i:0"><Icon name="description" />Your files<em>first</em></li>
        <li style="--i:1"><Icon name="account_balance" />Regulator data<em>primary</em></li>
        <li style="--i:2"><Icon name="request_quote" />Company filings<em>primary</em></li>
        <li style="--i:3"><Icon name="query_stats" />Industry reports<em>dated</em></li>
      </ul></div><h3>Researched and sourced</h3><p>Every data slide names its source.</p></article>

      <article class="tile rv"><div class="demo" aria-hidden="true"><ul class="ticks ok">
        {["No text overflow", "No overlaps", "Readable contrast", "Plain wording"].map((t, i) => <li style={`--i:${i}`}><Icon name="check_circle" />{t}</li>)}
      </ul></div><h3>Checks its own work</h3><p>Renders the slides and looks at them before handing over.</p></article>

      <article class="tile rv"><div class="demo" aria-hidden="true"><div class="notes"><small>Speaker notes · slide 4</small><span class="tw" data-type={notes}>{notes}</span></div></div><h3>Speaker notes</h3><p>What to say on every slide.</p></article>

      <article class="tile w2 rv"><div class="demo" aria-hidden="true"><div class="rewrite"><small>Headline</small><s>In today's fast-paced landscape, we leverage synergies to unlock growth</s><strong>Riders doubled in three quarters, and Pune turned profitable</strong></div></div><h3>Writes like a person</h3><p>Sentence headlines that state the point, numbers with units and dates, no stock AI phrasing.</p></article>
    </div>
  </div>
</section>

<script>
  import { $$, onFirstView, reduceMotion } from "../scripts/util";
  const still = reduceMotion();
  $$("#bento .tile").forEach((tile) => onFirstView(tile, () => {
    tile.classList.add("live");
    if (still) return;
    // image demos: step through once, then rest on the last image
    const cyc = tile.querySelector<HTMLElement>("[data-cycle]");
    if (cyc) {
      const imgs = Array.from(cyc.querySelectorAll("img"));
      let k = 0;
      const step = () => {
        if (k >= imgs.length - 1) return;
        imgs[k].classList.remove("on"); imgs[++k].classList.add("on");
        setTimeout(step, 1900);
      };
      setTimeout(step, 1400);
    }
    // speaker notes: type once
    const tw = tile.querySelector<HTMLElement>("[data-type]");
    if (tw) {
      const full = tw.dataset.type!; let i = 0; tw.textContent = ""; tw.classList.add("typing");
      const type = () => { tw.textContent = full.slice(0, ++i); if (i < full.length) setTimeout(type, 32); else tw.classList.remove("typing"); };
      setTimeout(type, 300);
    }
  }, 0.4));
</script>

<style>
  .bento { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .tile { border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--bg-2); padding: 20px; overflow: hidden; display: flex; flex-direction: column; gap: 6px; min-height: 260px; }
  .w2 { grid-column: span 2; }
  .tile h3 { font-size: 17px; }
  .tile p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
  .more { color: var(--accent-2); font-weight: 500; white-space: nowrap; }
  .more:hover { text-decoration: underline; text-underline-offset: 3px; }
  .demo { position: relative; flex: 1; min-height: 130px; margin-bottom: 14px; border-radius: 12px; background: rgba(0,0,0,.22); border: 1px solid var(--line); overflow: hidden; display: grid; place-items: center; }

  .chart { width: 100%; height: 100%; padding: 16px 18px 14px; display: grid; grid-template-rows: auto 1fr; gap: 8px; }
  .cap { display: flex; justify-content: space-between; font: 500 11px/1 var(--mono); color: var(--muted); }
  .cap b { color: var(--accent-2); font-weight: 500; }
  .bars { display: flex; align-items: flex-end; gap: 8px; min-height: 90px; }
  .bars i { flex: 1; height: 100%; border-radius: 5px 5px 2px 2px; background: linear-gradient(rgba(255,255,255,.3), rgba(255,255,255,.06)); transform-origin: bottom; transform: scaleY(var(--h)); }
  .bars i.hl { background: linear-gradient(var(--accent), rgba(255,107,61,.25)); }
  :global(.js) .bars i { transform: scaleY(.04); transition: transform .9s var(--ease); transition-delay: calc(var(--i) * 60ms); }
  :global(.js) .live .bars i { transform: scaleY(var(--h)); }

  .cycle { position: absolute; inset: 0; }
  .cycle :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; opacity: 0; transition: opacity .6s var(--ease); }
  .cycle :global(img.on) { opacity: 1; }
  .fit :global(img) { inset: 12px; width: calc(100% - 24px); height: calc(100% - 24px); object-fit: contain; }

  .ticks { list-style: none; margin: 0; width: 100%; padding: 14px; display: grid; gap: 7px; align-content: center; }
  .ticks li { display: flex; align-items: center; gap: 9px; height: 30px; padding: 0 10px; border-radius: 8px; background: rgba(255,255,255,.03); border: 1px solid var(--line); font-size: 12.5px; color: var(--soft); }
  .ticks :global(.i) { width: 16px; height: 16px; color: var(--muted); }
  .ticks.ok :global(.i) { color: var(--ok); }
  .ticks em { margin-left: auto; font: normal 500 10.5px var(--mono); color: var(--ok); }
  :global(.js) .ticks li { opacity: .3; transition: opacity .4s var(--ease); transition-delay: calc(var(--i) * 450ms + 200ms); }
  :global(.js) .live .ticks li { opacity: 1; }

  .notes { width: 100%; padding: 14px 16px; font: 12.5px/1.65 var(--mono); color: var(--soft); align-self: start; }
  .notes small { display: block; font: 500 10.5px/1 var(--mono); color: var(--muted); letter-spacing: .06em; text-transform: uppercase; margin-bottom: 8px; }
  .tw:global(.typing)::after { content: ""; display: inline-block; width: 7px; height: 1.1em; vertical-align: -0.2em; margin-left: 1px; background: var(--accent); }




  .rewrite { width: 100%; padding: 16px 18px; display: grid; gap: 10px; }
  .rewrite small { font: 500 10.5px/1 var(--mono); color: var(--faint); letter-spacing: .06em; text-transform: uppercase; }
  .rewrite s { font-size: 14px; color: var(--muted); text-decoration-thickness: 1.5px; text-decoration-color: var(--warn); }
  .rewrite strong { font-size: 17px; font-weight: 500; color: var(--ink); letter-spacing: -0.02em; }
  :global(.js) .rewrite s { text-decoration-color: transparent; transition: text-decoration-color .6s var(--ease) .5s; }
  :global(.js) .live .rewrite s { text-decoration-color: var(--warn); }
  :global(.js) .rewrite strong { opacity: 0; transform: translateY(6px); transition: opacity .5s var(--ease) 1.3s, transform .5s var(--ease) 1.3s; }
  :global(.js) .live .rewrite strong { opacity: 1; transform: none; }


  @media (max-width: 1180px) { .bento { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .bento { grid-template-columns: 1fr; gap: 10px; }
    .w2 { grid-column: span 1; }
    .tile { min-height: 0; padding: 16px; }
    .demo { flex: none; min-height: 124px; margin-bottom: 10px; }
  }
</style>
