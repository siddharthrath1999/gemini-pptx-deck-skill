---
import { getImage } from "astro:assets";
import Icon from "./Icon.astro";
import { img, meta } from "../lib/images";
import { AUDIENCES, EDITS } from "../data/content";

// Optimised URLs for every audience slide; the first deck is rendered, the rest swap in on demand.
const sizes = "(max-width: 980px) 92vw, 700px";
const decks = await Promise.all(AUDIENCES.map(async (a) => ({
  key: a.key,
  slides: await Promise.all([1, 2, 3, 4].map(async (n) => {
    const src = await meta(`audiences/${a.key}-${n}.jpg`);
    const [w700, w1100, thumb] = await Promise.all([
      getImage({ src, width: 700, format: "webp", quality: 80 }),
      getImage({ src, width: 1100, format: "webp", quality: 80 }),
      getImage({ src, width: 320, format: "webp", quality: 75 }),
    ]);
    return { src: w700.src, srcset: `${w700.src} 700w, ${w1100.src} 1100w`, thumb: thumb.src, alt: `${a.label} deck, slide ${n}` };
  })),
})));
const before = await getImage({ src: await meta("edit/before.jpg"), width: 1100, format: "webp", quality: 80 });
const after = await getImage({ src: await meta("edit/after.jpg"), width: 1100, format: "webp", quality: 80 });
const first = decks[0].slides;
---
<section id="audiences">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">Audiences and edits</span>
      <h2>It designs for who's in the room.</h2>
      <p class="lead">One company, four requests: the structure, slide types, wording and look all change. Already have a deck? The last tab shows an edit in your deck's own fonts and colours.</p>
    </div>

    <div class="tabs rv" role="tablist" aria-label="Choose an audience" id="audTabs">
      {AUDIENCES.map((a, i) => <button type="button" role="tab" id={`aud-tab-${a.key}`} aria-controls="audPanel" aria-selected={i === 0 ? "true" : "false"} data-i={i}><Icon name={a.icon} />{a.label}</button>)}
      <span class="sep" aria-hidden="true"></span>
      <button type="button" role="tab" id="aud-tab-edit" class="edit-tab" aria-controls="audPanel" aria-selected="false" data-i={AUDIENCES.length}><Icon name="edit_document" />Edit your deck</button>
    </div>

    <div class="aud rv" id="audPanel" role="tabpanel" aria-labelledby="aud-tab-board" data-decks={JSON.stringify(decks)}>
      <div class="stage">
        <div class="main" id="audMain">
          {first.map((s, i) => <img class={i === 0 ? "on" : ""} src={s.src} srcset={s.srcset} sizes={sizes} alt={s.alt} width="1100" height="618" loading="lazy" decoding="async" />)}
          <div class="ba" id="ba" style="--pos:50%" role="slider" tabindex="0" aria-label="Compare the slide before and after the edit" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" hidden>
            <img src={before.src} alt="The original slide: a plain bullet list" width="1100" height="619" loading="lazy" decoding="async" />
            <img class="after" src={after.src} alt="The same slide redesigned as four cards with icons" width="1100" height="619" loading="lazy" decoding="async" />
            <span class="tag l">Before</span><span class="tag r">After</span>
            <span class="handle"><span><Icon name="width" /></span></span>
          </div>
        </div>
        <div class="thumbs" id="audThumbs">
          {first.map((s, i) => <button type="button" class={i === 0 ? "on" : ""} aria-label={`Show slide ${i + 1}`} aria-pressed={i === 0 ? "true" : "false"} data-k={i}><img src={s.thumb} alt="" width="320" height="180" loading="lazy" decoding="async" /></button>)}
        </div>
      </div>

      <div class="info">
        {AUDIENCES.map((a, i) => (
          <div class="pane" data-pane={i} hidden={i !== 0}>
            <p class="q"><small>The request</small>{a.prompt}</p>
            <dl class="diff">{a.diff.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          </div>
        ))}
        <div class="pane" data-pane={AUDIENCES.length} hidden>
          <p class="q"><small>You attach a deck and ask</small>Turn slide 2 into something better than bullets. Keep our fonts and colours.</p>
          <ul class="edits">{EDITS.map(([icon, ask, result]) => <li><span class="well sm"><Icon name={icon} /></span><span>{ask}<em>{result}</em></span></li>)}</ul>
        </div>
      </div>
    </div>
    <p class="fine">Real renders from the skill with sample data for a fictional company, Lumen Bikes.</p>
  </div>
</section>

<script>
  import { $, $$, onFirstView, reduceMotion } from "../scripts/util";
  type Slide = { src: string; srcset: string; thumb: string; alt: string };
  const panel = $("#audPanel")!;
  const decks: { key: string; slides: Slide[] }[] = JSON.parse(panel.dataset.decks || "[]");
  const tabs = $$<HTMLButtonElement>("#audTabs [role=tab]");
  const main = $("#audMain")!, mainImgs = $$<HTMLImageElement>(":scope > img", main);
  const thumbs = $$<HTMLButtonElement>("#audThumbs button");
  const panes = $$("[data-pane]", panel);
  const ba = $("#ba")!;
  const EDIT = decks.length;
  let deck = 0, slide = 0, timer = 0, hovering = false, autoplay = false;

  function showSlide(k: number) {
    slide = k;
    mainImgs.forEach((im, j) => im.classList.toggle("on", j === k));
    thumbs.forEach((b, j) => { b.classList.toggle("on", j === k); b.setAttribute("aria-pressed", String(j === k)); });
  }
  function showDeck(i: number) {
    deck = i;
    tabs.forEach((t, j) => t.setAttribute("aria-selected", String(j === i)));
    panel.setAttribute("aria-labelledby", tabs[i].id);
    panes.forEach((p) => (p.hidden = Number(p.dataset.pane) !== i));
    const editing = i === EDIT;
    panel.classList.toggle("editing", editing);
    ba.hidden = !editing;
    if (editing) { nudge(); return; }
    decks[i].slides.forEach((s, j) => {
      const im = mainImgs[j]; im.src = s.src; im.srcset = s.srcset; im.alt = s.alt;
      const t = thumbs[j].querySelector("img")!; t.src = s.thumb;
    });
    showSlide(0);
  }
  function stop() { autoplay = false; clearTimeout(timer); }
  function tick() {
    if (!autoplay) return;
    if (hovering) { timer = window.setTimeout(tick, 400); return; }
    if (slide >= 3) { stop(); return; }
    showSlide(slide + 1);
    timer = window.setTimeout(tick, 2400);
  }

  tabs.forEach((t, i) => t.addEventListener("click", () => { stop(); showDeck(i); }));
  // arrow keys move between tabs
  $("#audTabs")!.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
    const i = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
    const n = (i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
    stop(); showDeck(n); tabs[n].focus();
  });
  thumbs.forEach((b, k) => b.addEventListener("click", () => { stop(); showSlide(k); }));
  panel.addEventListener("pointerenter", () => { hovering = true; });
  panel.addEventListener("pointerleave", () => { hovering = false; });
  if (!reduceMotion()) onFirstView(panel, () => { autoplay = true; timer = window.setTimeout(tick, 2400); }, 0.45);

  /* before/after slider */
  let dragging = false, touched = false;
  const setPos = (p: number) => { p = Math.max(0, Math.min(100, p)); ba.style.setProperty("--pos", `${p}%`); ba.setAttribute("aria-valuenow", String(Math.round(p))); };
  const fromEvent = (x: number) => { const r = ba.getBoundingClientRect(); setPos(((x - r.left) / r.width) * 100); };
  ba.addEventListener("pointerdown", (e) => { dragging = true; touched = true; ba.setPointerCapture(e.pointerId); fromEvent(e.clientX); });
  ba.addEventListener("pointermove", (e) => { if (dragging) fromEvent(e.clientX); });
  ba.addEventListener("pointerup", () => { dragging = false; });
  ba.addEventListener("pointercancel", () => { dragging = false; });
  ba.addEventListener("keydown", (e) => {
    const cur = Number(ba.getAttribute("aria-valuenow"));
    if (e.key === "ArrowLeft") { touched = true; setPos(cur - 5); e.preventDefault(); }
    if (e.key === "ArrowRight") { touched = true; setPos(cur + 5); e.preventDefault(); }
  });
  let nudged = false;
  function nudge() {
    if (nudged || touched || reduceMotion()) return;
    nudged = true;
    const keys = [[0, 50], [900, 22], [2100, 78], [2900, 50]];
    const t0 = performance.now();
    const ease = (x: number) => (x < .5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);
    (function frame(t: number) {
      if (touched) return;
      const el = t - t0;
      let k = 1; while (k < keys.length - 1 && el > keys[k][0]) k++;
      const [ta, pa] = keys[k - 1], [tb, pb] = keys[k];
      const x = Math.min(1, Math.max(0, (el - ta) / (tb - ta)));
      setPos(pa + (pb - pa) * ease(x));
      if (el < keys[keys.length - 1][0]) requestAnimationFrame(frame);
    })(t0);
  }
</script>

<style>
  .sep { width: 1px; margin: 8px 4px; background: var(--line-2); }
  .edit-tab[aria-selected="true"] { color: #ffd9c9; border-color: var(--accent-line) !important; background: rgba(255,107,61,.1) !important; }
  .aud { display: grid; grid-template-columns: 1.55fr 1fr; gap: 20px; align-items: start; }
  .stage { display: grid; gap: 10px; }
  .main { position: relative; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; border: 1px solid var(--line-2); background: var(--bg-2); }
  .main > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .4s var(--ease); }
  .main > img.on { opacity: 1; }
  .thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .thumbs button { padding: 0; border: 1px solid var(--line); border-radius: 9px; overflow: hidden; cursor: pointer; background: none; opacity: .55; transition: opacity .2s, border-color .2s; }
  .thumbs button:hover { opacity: .85; }
  .thumbs button.on { opacity: 1; border-color: var(--accent); }
  .thumbs img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  :global(.editing) .main > img { opacity: 0 !important; }
  :global(.editing) .thumbs { visibility: hidden; }

  .info { border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--bg-2); padding: 22px; }
  .pane { display: grid; gap: 18px; }
  .q { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink); border-left: 2px solid var(--accent); padding-left: 14px; }
  .q small { display: block; font: 400 11px/1 var(--mono); color: var(--muted); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 8px; }
  .diff { margin: 0; display: grid; gap: 10px; }
  .diff div { display: grid; grid-template-columns: 86px 1fr; gap: 12px; font-size: 14px; line-height: 1.5; color: var(--soft); padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .diff div:last-child { border-bottom: 0; padding-bottom: 0; }
  dt { font: 400 11px/1.9 var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  dd { margin: 0; }
  .edits { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .edits li { display: flex; align-items: center; gap: 12px; padding: 8px 12px 8px 8px; border-radius: 12px; background: rgba(255,255,255,.03); border: 1px solid var(--line); font-size: 13.5px; color: var(--soft); }
  .edits em { display: block; font-style: normal; color: var(--muted); font-size: 12px; margin-top: 2px; }

  .ba { position: absolute; inset: 0; user-select: none; touch-action: pan-y; cursor: ew-resize; }
  .ba img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba .after { clip-path: inset(0 0 0 var(--pos, 50%)); }
  .handle { position: absolute; top: 0; bottom: 0; left: var(--pos, 50%); width: 2px; background: #fff; transform: translateX(-1px); box-shadow: 0 0 0 1px rgba(0,0,0,.2); }
  .handle > span { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 38px; height: 38px; border-radius: 50%; background: #fff; color: #111; display: grid; place-items: center; box-shadow: 0 6px 20px rgba(0,0,0,.4); }
  .tag { position: absolute; top: 12px; height: 26px; display: inline-flex; align-items: center; padding: 0 10px; border-radius: 8px; font: 500 11.5px/1 var(--mono); background: rgba(14,14,16,.85); color: #fff; letter-spacing: .04em; }
  .tag.l { left: 12px; } .tag.r { right: 12px; background: var(--accent); color: var(--accent-ink); }
  @media (max-width: 980px) { .aud { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .sep { display: none; }
    .diff div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
