---
// See what it makes: real decks, one company pitched to four rooms, and an edit to an existing deck.
// One slide viewer (dialog) serves every [data-deck] button on the page, including How it works.
import { Image, getImage } from "astro:assets";
import Icon from "./Icon.astro";
import { img, meta } from "../lib/images";
import { EXAMPLES, AUDIENCES, EDITS } from "../data/content";

const slideSet = async (title: string, paths: string[]) => ({
  title,
  slides: await Promise.all(paths.map(async (p) => {
    const m = await meta(p);
    const [full, thumb] = await Promise.all([
      getImage({ src: m, width: Math.min(m.width, 1600), format: "webp", quality: 82 }),
      getImage({ src: m, width: 240, format: "webp", quality: 70 }),
    ]);
    return { full: full.src, thumb: thumb.src };
  })),
});
const audSlides = (k: string) => [1, 2, 3, 4].map((n) => `audiences/${k}-${n}.jpg`);
// deck index: 0-3 example decks, 4-7 audience decks
const decks = await Promise.all([
  ...EXAMPLES.map((d) => slideSet(d.title, d.slides)),
  ...AUDIENCES.map((a) => slideSet(`${a.label} · Lumen Bikes`, audSlides(a.key))),
]);
const before = await getImage({ src: await meta("edit/before.jpg"), width: 1100, format: "webp", quality: 80 });
const after = await getImage({ src: await meta("edit/after.jpg"), width: 1100, format: "webp", quality: 80 });
const cardSizes = "(max-width: 640px) 80vw, (max-width: 1100px) 46vw, 290px";
const tabs = [
  { key: "decks", label: "Real decks", icon: "slideshow" },
  { key: "rooms", label: "For every room", icon: "groups" },
  { key: "edit", label: "Your own deck", icon: "edit_document" },
];
---
<section id="examples">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">Made with PPTX Native</span>
      <h2>See what it makes.</h2>
      <p class="lead">Real decks from one-line requests, the same company pitched to four different rooms, and an edit to a deck someone already had.</p>
    </div>

    <div class="tabs rv" role="tablist" aria-label="Choose what to see" id="showTabs">
      {tabs.map((t, i) => <button type="button" role="tab" id={`show-tab-${t.key}`} aria-controls={`show-${t.key}`} aria-selected={i === 0 ? "true" : "false"}><Icon name={t.icon} />{t.label}</button>)}
    </div>

    <div class="pane rv" id="show-decks" role="tabpanel" aria-labelledby="show-tab-decks">
      <ul class="cards">
        {EXAMPLES.map((d, i) => (
          <li><button type="button" class="card" data-deck={i} aria-haspopup="dialog">
            <span class="cover"><Image src={img(d.slides[0])} alt={`Cover of the ${d.title} deck`} widths={[400, 700]} sizes={cardSizes} /></span>
            <span class="meta">
              <span class="title">{d.title}</span>
              <span class="sub">{d.stats.join(" · ")}</span>
              <span class="open"><Icon name="slideshow" />Page through</span>
            </span>
          </button></li>
        ))}
      </ul>
      <p class="fine">Made from online sources in October 2026. Figures have not been independently checked.</p>
    </div>

    <div class="pane" id="show-rooms" role="tabpanel" aria-labelledby="show-tab-rooms" hidden>
      <ul class="cards">
        {AUDIENCES.map((a, i) => (
          <li><button type="button" class="card" data-deck={EXAMPLES.length + i} aria-haspopup="dialog">
            <span class="cover"><Image src={img(`audiences/${a.key}-2.jpg`)} alt={`A slide from the ${a.label.toLowerCase()} deck`} widths={[400, 700]} sizes={cardSizes} /></span>
            <span class="meta">
              <span class="title"><Icon name={a.icon} />{a.label}</span>
              <span class="sub">{a.diff.find(([k]) => k === "Look")![1]}</span>
              <span class="ask">“{a.prompt}”</span>
            </span>
          </button></li>
        ))}
      </ul>
      <p class="fine">Four requests about one fictional company, Lumen Bikes. Structure, slide types, wording and look all change with the room.</p>
    </div>

    <div class="pane" id="show-edit" role="tabpanel" aria-labelledby="show-tab-edit" hidden>
      <div class="edit">
        <div class="ba" id="ba" style="--pos:50%" role="slider" tabindex="0" aria-label="Compare the slide before and after the edit" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
          <img src={before.src} alt="The original slide: a plain bullet list" width="1100" height="619" loading="lazy" decoding="async" />
          <img class="after" src={after.src} alt="The same slide redesigned as four cards with icons" width="1100" height="619" loading="lazy" decoding="async" />
          <span class="tag l">Before</span><span class="tag r">After</span>
          <span class="handle"><span><Icon name="width" /></span></span>
        </div>
        <div class="edit-side">
          <p class="q"><small>Attach your deck and ask</small>Turn slide 2 into something better than bullets. Keep our fonts and colours.</p>
          <ul class="edits">{EDITS.slice(1).map(([icon, ask, result]) => <li><span class="well sm"><Icon name={icon} /></span><span>{ask}<em>{result}</em></span></li>)}</ul>
        </div>
      </div>
    </div>
  </div>
</section>

<dialog class="lb" id="lightbox" aria-labelledby="lbTitle" data-decks={JSON.stringify(decks)}>
  <div class="lb-top"><h2 id="lbTitle"></h2><span class="lb-count" id="lbCount"></span><button type="button" class="btn icon" id="lbClose" aria-label="Close"><Icon name="close" /></button></div>
  <div class="lb-main">
    <button type="button" class="btn icon" id="lbPrev" aria-label="Previous slide"><Icon name="chevron_left" /></button>
    <img id="lbImg" alt="" decoding="async" />
    <button type="button" class="btn icon" id="lbNext" aria-label="Next slide"><Icon name="chevron_right" /></button>
  </div>
  <div class="lb-strip" id="lbStrip"></div>
</dialog>

<script>
  import { $, $$, reduceMotion } from "../scripts/util";

  /* tabs */
  const tabs = $$<HTMLButtonElement>("#showTabs [role=tab]");
  let editSeen = false;
  function show(i: number) {
    tabs.forEach((t, j) => {
      t.setAttribute("aria-selected", String(j === i));
      $(`#${t.getAttribute("aria-controls")}`)!.hidden = j !== i;
    });
    if (tabs[i].id === "show-tab-edit" && !editSeen) { editSeen = true; nudge(); }
  }
  tabs.forEach((t, i) => t.addEventListener("click", () => show(i)));
  $("#showTabs")!.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
    const i = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
    const n = (i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
    show(n); tabs[n].focus();
  });

  /* slide viewer, opened by any [data-deck] button on the page */
  type Deck = { title: string; slides: { full: string; thumb: string }[] };
  const dlg = $<HTMLDialogElement>("#lightbox")!, im = $<HTMLImageElement>("#lbImg")!, strip = $("#lbStrip")!;
  const decks: Deck[] = JSON.parse(dlg.dataset.decks || "[]");
  const title = $("#lbTitle")!, count = $("#lbCount")!;
  let deck: Deck | null = null, at = 0, opener: HTMLElement | null = null;
  function go(i: number) {
    if (!deck) return;
    at = (i + deck.slides.length) % deck.slides.length;
    im.src = deck.slides[at].full;
    im.alt = `${deck.title}, slide ${at + 1} of ${deck.slides.length}`;
    count.textContent = `${at + 1} / ${deck.slides.length}`;
    $$("button", strip).forEach((b, k) => b.setAttribute("aria-current", String(k === at)));
    const next = new Image(); next.src = deck.slides[(at + 1) % deck.slides.length].full;
  }
  function open(i: number, k: number, from: HTMLElement) {
    deck = decks[i]; opener = from;
    title.textContent = deck.title;
    strip.innerHTML = "";
    deck.slides.forEach((s, j) => {
      const b = document.createElement("button");
      b.type = "button"; b.setAttribute("aria-label", `Slide ${j + 1}`);
      const t = document.createElement("img"); t.src = s.thumb; t.alt = ""; t.width = 240; t.height = 135;
      b.append(t); b.addEventListener("click", () => go(j)); strip.append(b);
    });
    go(k);
    dlg.showModal();
  }
  document.addEventListener("click", (e) => {
    const b = (e.target as Element).closest?.<HTMLElement>("[data-deck]");
    if (b) open(Number(b.dataset.deck), Number(b.dataset.slide || 0), b);
  });
  $("#lbPrev")!.addEventListener("click", () => go(at - 1));
  $("#lbNext")!.addEventListener("click", () => go(at + 1));
  $("#lbClose")!.addEventListener("click", () => dlg.close());
  dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener("keydown", (e) => { if (e.key === "ArrowRight") go(at + 1); if (e.key === "ArrowLeft") go(at - 1); });
  let sx = 0;
  im.addEventListener("pointerdown", (e) => { sx = e.clientX; });
  im.addEventListener("pointerup", (e) => { const d = e.clientX - sx; if (Math.abs(d) > 40) go(at + (d < 0 ? 1 : -1)); });
  dlg.addEventListener("close", () => { opener?.focus(); document.documentElement.style.overflow = ""; });
  new MutationObserver(() => { document.documentElement.style.overflow = dlg.open ? "hidden" : ""; }).observe(dlg, { attributes: true, attributeFilter: ["open"] });

  /* before/after slider */
  const ba = $("#ba")!;
  let dragging = false, touched = false;
  const setPos = (p: number) => { p = Math.max(0, Math.min(100, p)); ba.style.setProperty("--pos", `${p}%`); ba.setAttribute("aria-valuenow", String(Math.round(p))); };
  const fromEvent = (x: number) => { const r = ba.getBoundingClientRect(); setPos(((x - r.left) / r.width) * 100); };
  ba.addEventListener("pointerdown", (e) => { dragging = true; touched = true; ba.setPointerCapture(e.pointerId); fromEvent(e.clientX); });
  ba.addEventListener("pointermove", (e) => { if (dragging) fromEvent(e.clientX); });
  ba.addEventListener("pointerup", () => { dragging = false; });
  ba.addEventListener("pointercancel", () => { dragging = false; });
  ba.addEventListener("keydown", (e) => {
    const cur = Number(ba.getAttribute("aria-valuenow"));
    if (e.key === "ArrowLeft") { touched = true; setPos(cur - 5); e.preventDefault(); }
    if (e.key === "ArrowRight") { touched = true; setPos(cur + 5); e.preventDefault(); }
  });
  // one gentle sweep the first time the edit tab is shown, so the handle reads as draggable
  function nudge() {
    if (touched || reduceMotion()) return;
    const keys = [[0, 50], [900, 22], [2100, 78], [2900, 50]];
    const t0 = performance.now();
    const ease = (x: number) => (x < .5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);
    (function frame(t: number) {
      if (touched) return;
      const el = t - t0;
      let k = 1; while (k < keys.length - 1 && el > keys[k][0]) k++;
      const [ta, pa] = keys[k - 1], [tb, pb] = keys[k];
      const x = Math.min(1, Math.max(0, (el - ta) / (tb - ta)));
      setPos(pa + (pb - pa) * ease(x));
      if (el < keys[keys.length - 1][0]) requestAnimationFrame(frame);
    })(t0);
  }
</script>

<style>
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .card { all: unset; box-sizing: border-box; display: flex; flex-direction: column; width: 100%; height: 100%; border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--line); background: var(--bg-2); cursor: pointer; transition: border-color .2s; }
  .card:hover { border-color: var(--line-3); }
  .card:focus-visible { outline: 2px solid var(--accent-2); outline-offset: 3px; }
  .cover { display: block; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--line); }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .card:hover .cover :global(img) { transform: scale(1.03); }
  .meta { flex: 1; display: flex; flex-direction: column; gap: 6px; padding: 16px 16px 18px; }
  .title { display: flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.3; color: var(--ink); }
  .title :global(.i) { width: 19px; height: 19px; color: var(--muted); }
  .sub { color: var(--muted); font-size: 13px; line-height: 1.45; }
  .ask { margin-top: 4px; font-size: 13px; line-height: 1.5; color: var(--soft); }
  .open { margin-top: auto; padding-top: 8px; display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 500; color: var(--accent-2); }
  .open :global(.i) { width: 18px; height: 18px; }

  .edit { display: grid; grid-template-columns: 1.55fr 1fr; gap: 20px; align-items: start; }
  .edit-side { display: grid; gap: 18px; padding: 22px; border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--bg-2); }
  .q { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink); border-left: 2px solid var(--accent); padding-left: 14px; }
  .q small { display: block; font: 400 11px/1 var(--mono); color: var(--muted); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 8px; }
  .edits { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .edits li { display: flex; align-items: center; gap: 12px; padding: 8px 12px 8px 8px; border-radius: 12px; background: rgba(255,255,255,.03); border: 1px solid var(--line); font-size: 13.5px; color: var(--soft); }
  .edits em { display: block; font-style: normal; color: var(--muted); font-size: 12px; margin-top: 2px; }
  .ba { position: relative; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; border: 1px solid var(--line-2); user-select: none; touch-action: pan-y; cursor: ew-resize; }
  .ba img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba .after { clip-path: inset(0 0 0 var(--pos, 50%)); }
  .handle { position: absolute; top: 0; bottom: 0; left: var(--pos, 50%); width: 2px; background: #fff; transform: translateX(-1px); box-shadow: 0 0 0 1px rgba(0,0,0,.2); }
  .handle > span { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 38px; height: 38px; border-radius: 50%; background: #fff; color: #111; display: grid; place-items: center; box-shadow: 0 6px 20px rgba(0,0,0,.4); }
  .tag { position: absolute; top: 12px; height: 26px; display: inline-flex; align-items: center; padding: 0 10px; border-radius: 8px; font: 500 11.5px/1 var(--mono); background: rgba(14,14,16,.85); color: #fff; letter-spacing: .04em; }
  .tag.l { left: 12px; } .tag.r { right: 12px; background: var(--accent); color: var(--accent-ink); }

  .lb { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 20px; border: 0; background: rgba(6,6,7,.94); color: var(--ink); }
  .lb[open] { display: grid; grid-template-rows: auto 1fr auto; gap: 14px; }
  .lb::backdrop { background: transparent; }
  .lb-top { display: flex; align-items: center; gap: 12px; width: min(1200px, 100%); margin: 0 auto; }
  .lb-top h2 { font-size: 16px; letter-spacing: -0.01em; }
  .lb-count { font: 500 12px/1 var(--mono); color: var(--muted); margin-right: auto; }
  .lb-main { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; min-height: 0; width: min(1280px, 100%); margin: 0 auto; }
  .lb-main img { touch-action: pan-y; max-height: 100%; max-width: 100%; margin: 0 auto; border-radius: 12px; box-shadow: 0 40px 120px -30px #000; aspect-ratio: 16 / 9; object-fit: contain; }
  .lb-strip { display: flex; gap: 8px; justify-content: center; overflow-x: auto; padding-bottom: 4px; }
  .lb-strip :global(button) { all: unset; flex: none; cursor: pointer; border-radius: 7px; opacity: .45; transition: opacity .2s; }
  .lb-strip :global(button[aria-current="true"]) { opacity: 1; outline: 2px solid var(--accent); }
  .lb-strip :global(button:focus-visible) { outline: 2px solid var(--accent-2); }
  .lb-strip :global(img) { width: 110px; height: auto; border-radius: 7px; }

  @media (max-width: 1100px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* three short tabs always fit, so no edge fade */
  @media (max-width: 980px) { #showTabs { mask-image: none; -webkit-mask-image: none; } }
  @media (max-width: 900px) { .edit { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    /* cards become a swipeable row so the section stays one screen tall */
    .cards { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin: 0 -16px; padding: 0 16px 4px; gap: 12px; }
    .cards::-webkit-scrollbar { display: none; }
    .cards li { flex: 0 0 80%; scroll-snap-align: start; }
    #showTabs { width: 100%; }
    #showTabs :global(.i) { display: none; }
    #showTabs button { flex: 1 1 auto; justify-content: center; padding: 0 8px; font-size: 13px; }
    .lb { padding: 12px; }
    .lb-main { grid-template-columns: 1fr; }
    .lb-main :global(#lbPrev), .lb-main :global(#lbNext) { display: none; }
  }
</style>
