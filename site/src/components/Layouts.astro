---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { img } from "../lib/images";
import { LAYOUTS, LAYOUT_FILTERS } from "../data/content";
const count = (k: string) => (k === "all" ? LAYOUTS.length : LAYOUTS.filter((l) => l[2] === k).length);
---
<section id="layouts">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">34 layouts</span>
      <h2>A layout for every kind of point.</h2>
      <p class="lead">A number gets a big number. A ranking gets bars. A process gets steps. Gemini picks from the shape of your content.</p>
    </div>
    <div class="tabs rv" role="tablist" aria-label="Filter layouts" id="layoutFilters">
      {LAYOUT_FILTERS.map((f, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls="posterGrid" data-f={f.key}><Icon name={f.icon} />{f.label}<span class="count">{count(f.key)}</span></button>)}
    </div>
    <ul class="grid collapsed" id="posterGrid" data-limit="8">
      {LAYOUTS.map(([name, desc, cat, n]) => (
        <li class="poster" data-cat={cat}>
          <Image src={img(`layouts/l${String(n).padStart(2, "0")}.jpg`)} alt={`${name} layout`} widths={[400, 760]} sizes="(max-width: 640px) 46vw, (max-width: 980px) 46vw, (max-width: 1100px) 31vw, 280px" />
          <h3>{name}</h3>
          <p>{desc}</p>
        </li>
      ))}
    </ul>
    <div class="more"><button type="button" class="btn" id="showAll" aria-controls="posterGrid" aria-expanded="false">
      <span class="when-more"><Icon name="expand_more" /></span><span class="when-less"><Icon name="expand_less" /></span><span id="showAllLabel">Show all 34 layouts</span>
    </button></div>
  </div>
</section>

<script>
  import { $, $$ } from "../scripts/util";
  const grid = $("#posterGrid")!, btn = $("#showAll")!, lbl = $("#showAllLabel")!;
  const tabs = $$<HTMLButtonElement>("#layoutFilters [role=tab]");
  const posters = $$("li", grid);
  const limit = Number(grid.dataset.limit) || 8;
  let filter = "all", expanded = false;
  grid.classList.remove("collapsed"); // JS now controls visibility
  function apply() {
    let shown = 0, total = 0;
    posters.forEach((p) => {
      const ok = filter === "all" || p.dataset.cat === filter;
      if (ok) total++;
      const vis = ok && (expanded || shown < limit);
      p.hidden = !vis;
      if (vis) shown++;
    });
    btn.parentElement!.hidden = total <= limit;
    btn.setAttribute("aria-expanded", String(expanded));
    btn.classList.toggle("open", expanded);
    lbl.textContent = expanded ? "Show fewer" : `Show all ${total} layouts`;
  }
  tabs.forEach((t) => t.addEventListener("click", () => {
    tabs.forEach((x) => x.setAttribute("aria-selected", String(x === t)));
    filter = t.dataset.f!; expanded = false; apply();
  }));
  btn.addEventListener("click", () => {
    expanded = !expanded; apply();
    if (!expanded) document.getElementById("layouts")!.scrollIntoView({ block: "start" });
  });
  apply();
</script>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .poster { border-radius: 16px; padding: 7px 7px 14px; border: 1px solid var(--line); background: var(--bg-2); transition: border-color .2s; }
  .poster:hover { border-color: var(--line-2); }
  .poster :global(img) { border-radius: 10px; aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  h3 { font-size: 14.5px; font-weight: 500; letter-spacing: -0.01em; margin: 12px 7px 2px; }
  .poster p { margin: 0 7px; font-size: 13px; color: var(--muted); line-height: 1.45; }
  /* before JS runs, show only the first eight */
  :global(.js) .collapsed li:nth-child(n + 9) { display: none; }
  .more { display: flex; justify-content: center; margin-top: 24px; }
  .when-less { display: none; line-height: 0; }
  .when-more { line-height: 0; }
  :global(#showAll.open) .when-less { display: inline; }
  :global(#showAll.open) .when-more { display: none; }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { gap: 10px; } .poster p { display: none; } }
</style>
