---
import Icon from "./Icon.astro";
import { GITHUB, ZIP_URL } from "../data/content";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<section class="cta">
  <div class="wrap">
    <div class="card rv">
      <div class="flow" role="img" aria-label="Gemini or Antigravity makes a PowerPoint file">
        <span class="app gemini"><img src={`${base}logos/gemini-2025.svg`} alt="" width="36" height="36" loading="lazy" /></span>
        <span class="op"><Icon name="add" /></span>
        <span class="app agy"><img src={`${base}logos/antigravity.png`} alt="" width="36" height="36" loading="lazy" /></span>
        <span class="op"><Icon name="arrow_forward" /></span>
        <span class="app ppt"><img src={`${base}logos/powerpoint.svg`} alt="" width="36" height="36" loading="lazy" /></span>
      </div>
      <h2>Your next deck is one sentence away.</h2>
      <p>Free and open source. Add it to Gemini in two minutes, or to Antigravity with one line.</p>
      <div class="row">
        <a class="btn primary lg" href={ZIP_URL}><Icon name="download" />Download for Gemini</a>
        <a class="btn lg" href="#setup" data-agy="1"><Icon name="terminal" />Install in Antigravity</a>
      </div>
      <a class="textlink" href={GITHUB}>Read the source on GitHub<Icon name="arrow_forward" /></a>
    </div>
  </div>
</section>

<style>
  .cta { padding-bottom: calc(var(--sec) * .9); }
  .card { position: relative; border-radius: 32px; overflow: hidden; padding: clamp(44px, 6vw, 80px) clamp(24px, 5vw, 64px); text-align: center; background: radial-gradient(80% 110% at 50% 0%, rgba(255,107,61,.22), transparent 62%), radial-gradient(60% 80% at 50% 120%, rgba(59,79,216,.14), transparent 70%), linear-gradient(180deg, #141312, #0d0d0e); border: 1px solid rgba(255,107,61,.24); }
  .flow { display: inline-flex; align-items: center; gap: 14px; margin-bottom: 32px; }
  .flow .app { --s: 64px; }
  .op { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; color: var(--muted); border: 1px solid var(--line-2); background: rgba(255,255,255,.03); }
  .op :global(.i) { width: 17px; height: 17px; }
  h2 { max-width: 16ch; margin: 0 auto 16px; }
  p { color: var(--soft); font-size: 17px; margin: 0 auto 28px; max-width: 46ch; }
  .row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .textlink { margin-top: 22px; }
  @media (max-width: 640px) {
    .flow { gap: 8px; } .flow .app { --s: 52px; }
    .row .btn { width: 100%; }
  }
</style>
