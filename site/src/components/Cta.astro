---
import Icon from "./Icon.astro";
import { GITHUB, ZIP_URL } from "../data/content";
---
<section class="cta">
  <div class="wrap">
    <div class="card rv">
      <h2>Your next deck is one sentence away.</h2>
      <p>Free and open source. Add it to Gemini in two minutes, or to Antigravity with one line.</p>
      <div class="row">
        <a class="btn primary lg" href={ZIP_URL}><Icon name="download" />Download for Gemini</a>
        <a class="btn lg" href="#setup-antigravity"><Icon name="terminal" />Install in Antigravity</a>
      </div>
      <a class="textlink" href={GITHUB}>Read the source on GitHub<Icon name="arrow_forward" /></a>
    </div>
  </div>
</section>

<style>
  .cta { padding-bottom: calc(var(--sec) * .9); }
  .card { position: relative; border-radius: 32px; overflow: hidden; padding: clamp(44px, 6vw, 80px) clamp(24px, 5vw, 64px); text-align: center; background: radial-gradient(80% 110% at 50% 0%, rgba(255,107,61,.22), transparent 62%), radial-gradient(60% 80% at 50% 120%, rgba(59,79,216,.14), transparent 70%), linear-gradient(180deg, #141312, #0d0d0e); border: 1px solid rgba(255,107,61,.24); }
  h2 { max-width: 16ch; margin: 0 auto 16px; }
  p { color: var(--soft); font-size: 17px; margin: 0 auto 28px; max-width: 46ch; }
  .row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .textlink { margin-top: 22px; }
  @media (max-width: 640px) {
    .row .btn { width: 100%; }
  }
</style>
