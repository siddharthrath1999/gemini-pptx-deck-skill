---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Why from "../components/Why.astro";
import How from "../components/How.astro";
import Showcase from "../components/Showcase.astro";
import Features from "../components/Features.astro";
import Setup from "../components/Setup.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import { GITHUB, ZIP_URL } from "../data/content";
// Lets search engines show this as a free software app.
const ld = JSON.stringify({
  "@context": "https://schema.org", "@type": "SoftwareApplication", name: "PPTX Native",
  applicationCategory: "BusinessApplication", operatingSystem: "Gemini app, Google Antigravity",
  description: "A free, open-source skill that turns a one-line request into a researched, fully editable PowerPoint deck, or edits the deck you already have.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  license: "https://opensource.org/licenses/MIT", codeRepository: GITHUB, downloadUrl: ZIP_URL,
});
---
<Base
  page="home"
  title="PPTX Native · Real PowerPoint, straight from Gemini"
  description="PPTX Native is a free, open-source skill for Gemini and Google Antigravity. Ask in one line and get a researched, designed, fully editable PowerPoint deck, or edit the deck you already have."
>
  <script type="application/ld+json" slot="head" set:html={ld} />
  <Hero />
  <Why />
  <How />
  <Showcase />
  <Features />
  <Setup />
  <Faq />
  <Cta />
</Base>
